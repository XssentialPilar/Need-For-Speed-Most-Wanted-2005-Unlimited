static int ControlLanguage() {
    const int language = At<int>(0x8f41c0);
    if (language >= 0 && language <= 9) return language;
    if (language == 12 || language == 13) return language - 2;
    return 0;
}
static const char* ControlText(int label) {
    return kControlText[ControlLanguage()][label];
}
